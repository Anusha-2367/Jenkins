pipeline {

    agent none

    options {
        skipDefaultCheckout(true)
    }

    stages {

        stage('Workspace Test') {

            agent {
                label 'windows'
            }

            steps {

                echo '===== RUNNING ON WINDOWS AGENT ====='

                bat 'hostname'
                bat 'whoami'

                echo '===== CHECKOUT SOURCE CODE ====='

                checkout scm

                echo '===== WORKSPACE ====='

                bat 'echo Workspace: %WORKSPACE%'

                echo '===== PROJECT FILES ====='

                bat 'dir /b'

                echo '===== GIT STATUS ====='

                bat 'git status'
            }
        }
    }
}