pipeline {

    agent {
        label 'windows'
    }

    stages {

        stage('Agent Test') {
            steps {
                echo 'Testing Windows Agent'

                bat 'echo ===== AGENT TEST ====='
                bat 'whoami'
                bat 'hostname'
                bat 'echo WORKSPACE=%WORKSPACE%'
            }
        }
    }

    post {
        success {
            echo 'Windows Agent test completed successfully!'
        }
    }
}