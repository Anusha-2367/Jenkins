
 // Testing GitHub webhook trigger

pipeline {

    agent none

    options {
        skipDefaultCheckout(true)
    }

    stages {

        stage('Workspace Test') {

            agent {
                label 'windows'
            }

            steps {

                echo '===== RUNNING ON WINDOWS AGENT ====='

                bat 'hostname'
                bat 'whoami'

                echo '===== CHECKOUT SOURCE CODE ====='

                checkout scm

                echo '===== WORKSPACE ====='

                bat 'echo Workspace: %WORKSPACE%'

                echo '===== PROJECT FILES ====='

                bat 'dir /b'

                echo '===== Testing GitHub Webhook Trigger ====='

                bat 'git status'
            }
        }

        stage('Create Artifact') {

            agent {
                label 'windows'
            }

            steps {
                echo '===== CREATING BUILD ARTIFACT ====='

                bat 'echo This is my first Jenkins artifact > build-info.txt'

                bat 'type build-info.txt'
            }

            post {
                success {
                    archiveArtifacts(
                        artifacts: 'build-info.txt',
                        fingerprint: true
                    )
                }
            }
        }
    }
}
