pipeline {

    agent {
        label 'windows'
    }

    stages {

        stage('Check Workspace') {
            steps {
                echo 'Checking Jenkins workspace'

                bat 'echo Current workspace: %WORKSPACE%'
                bat 'dir'
            }
        }

        stage('Show Files') {
            steps {
                bat 'echo ===== PROJECT FILES ====='
                bat 'dir /b'
            }
        }
    }

    post {
        success {
            echo 'Workspace test completed successfully!'
        }

        failure {
            echo 'Workspace test failed!'
        }
    }
}