pipeline {

    agent {
    label 'windows'
}

    stages {

        stage('Use Credential') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'demo-secret',
                        variable: 'MY_SECRET'
                    )
                ]) {
                    echo "Credential is available to Jenkins"
                }
            }
        }
    }
}