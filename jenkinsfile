pipeline {

    agent none

    stages {

        stage('Workspace Test') {

            agent {
                label 'windows'
            }

            steps {

                echo '===== JENKINS WORKSPACE ====='

                bat 'echo Workspace: %WORKSPACE%'

                echo '===== PROJECT FILES ====='

                bat 'dir /b'

                echo '===== GIT STATUS ====='

                bat 'git status'
            }
        }
    }
}