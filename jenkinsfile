pipeline {

    agent {
    label 'windows'
}

    stages {
        stage('Check Agent') {
    steps {
        bat 'whoami'
        bat 'hostname'
        bat 'java -version'
    }
}

        stage('Use Credential') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'demo-secret',
                        variable: 'MY_SECRET'
                    )
                ]) {
                    echo "Credential is available to Jenkins"
                }
            }
        }
    }
}